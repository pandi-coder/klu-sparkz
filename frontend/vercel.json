{
  "version": 2,
  "name": "klu-sparkz-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "@klu_api_url",
    "VITE_SUPABASE_URL": "@klu_supabase_url",
    "VITE_SUPABASE_ANON_KEY": "@klu_supabase_anon_key"
  }
}
